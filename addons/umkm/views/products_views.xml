<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Products Search View -->
        <record id="view_umkm_products_search" model="ir.ui.view">
            <field name="name">umkm.products.search</field>
            <field name="model">umkm.products</field>
            <field name="arch" type="xml">
                <search string="Search Products">
                    <field name="name"/>
                    <field name="_type"/>
                    <field name="profile_id"/>
                    <filter string="Has PIRT" name="has_pirt" domain="[('pirt_status', 'in', ['owned', 'owned_created'])]"/>
                    <filter string="Has Halal" name="has_halal" domain="[('halal_status', 'in', ['owned', 'owned_created'])]"/>
                    <filter string="Has BPOM" name="has_bpom" domain="[('bpom_status', 'in', ['owned', 'owned_created'])]"/>
                </search>
            </field>
        </record>

        <!-- Products List View -->
        <record id="view_umkm_products_list" model="ir.ui.view">
            <field name="name">umkm.products.list</field>
            <field name="model">umkm.products</field>
            <field name="arch" type="xml">
                <list string="Products" sample="1" multi_edit="1" create="true">
                    <field name="image_1920" widget="image" options="{'size': [24, 24], 'img_class': 'o_avatar rounded'}" width="30" nolabel="1"/>
                    <field name="name" string="Name"/>
                    <field name="_type" string="Type" optional="show"/>
                    <field name="profile_id" optional="hide"/>
                </list>
            </field>
        </record>

        <!-- Products Form View -->
        <record id="view_umkm_products_form" model="ir.ui.view">
            <field name="name">umkm.products.form</field>
            <field name="model">umkm.products</field>
            <field name="arch" type="xml">
                <form string="Products" create="true">
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <div class="mb8">
                        <div class="d-flex gap-3">
                            <field name="image_1920" widget="image" options="{'preview_image': 'image_1920', 'size': [130,130], 'img_class': 'rounded border'}"/>
                            <div class="d-flex flex-column flex-grow-1">
                                <h1 class="mb-0 w-md-75">
                                    <field options="{'line_breaks': False}" widget="text" class="text-break d-block" name="name" default_focus="1" placeholder="e.g. Nasi Goreng Spesial"/>
                                </h1>
                                <div class="d-flex align-items-baseline w-md-50">
                                    <i class="fa fa-fw me-1 fa-tag text-primary" title="Type"/>
                                    <field name="_type" class="w-100" placeholder="Product Type"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <group>
                        <group>
                            <field name="profile_id" placeholder="UMKM Profile"/>
                            <field name="komposisi" placeholder="Composition"/>
                        </group>
                        <group>
                            <field name="description" placeholder="Description"/>
                        </group>
                    </group>
                    <notebook colspan="4">
                        <page name="certificates" string="Certificates">
                            <group col="2">
                                <group string="PIRT">
                                    <field name="pirt_status" placeholder="Pilih status PIRT"/>
                                    <field name="pirt_no" invisible="pirt_status not in ['owned', 'owned_created']" placeholder="Masukkan nomor PIRT"/>
                                    <field name="pirt_file" filename="pirt_no" invisible="pirt_status not in ['owned', 'owned_created']" placeholder="Unggah file PIRT"/>
                                </group>
                                <group string="Halal">
                                    <field name="halal_status" placeholder="Pilih status Halal"/>
                                    <field name="halal_no" invisible="halal_status not in ['owned', 'owned_created']" placeholder="Masukkan nomor Halal"/>
                                    <field name="halal_file" filename="halal_no" invisible="halal_status not in ['owned', 'owned_created']" placeholder="Unggah file Halal"/>
                                </group>
                                <group string="BPOM">
                                    <field name="bpom_status" placeholder="Pilih status BPOM"/>
                                    <field name="bpom_no" invisible="bpom_status not in ['owned', 'owned_created']" placeholder="Masukkan nomor BPOM"/>
                                    <field name="bpom_file" filename="bpom_no" invisible="bpom_status not in ['owned', 'owned_created']" placeholder="Unggah file BPOM"/>
                                </group>
                            </group>
                        </page>
                        <page name="packaging" string="Packaging">
                            <field name="packaging_ids">
                                <list editable="bottom">
                                    <field name="type"/>
                                    <field name="netto"/>
                                    <field name="netto_unit"/>
                                    <field name="price"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="packaging_file" filename="packaging_file_name"/>
                                    <field name="packaging_file_name" invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
                </form>
            </field>
        </record>

        <!-- Products Kanban View (Catalog) -->
        <record id="view_umkm_products_kanban" model="ir.ui.view">
            <field name="name">umkm.products.kanban</field>
            <field name="model">umkm.products</field>
            <field name="arch" type="xml">
                <kanban sample="1" create="true">
                    <field name="image_1920"/>
                    <field name="_type"/>
                    <field name="currency_id"/>
                    <field name="profile_id"/>
                    <field name="netto"/>
                    <field name="netto_display"/>
                    <field name="show_certificates"/>
                    <field name="pirt_icon_color"/>
                    <field name="halal_icon_color"/>
                    <field name="bpom_icon_color"/>
                    <field name="pirt_tooltip"/>
                    <field name="halal_tooltip"/>
                    <field name="bpom_tooltip"/>
                    <templates>
                        <t t-name="card" class="flex-row">
                            <aside class="o_kanban_aside_full">
                                <div class="position-relative w-100 h-auto m-0">
                                    <field name="image_1920" alt="Product image" class="h-100" widget="image" options="{'img_class': 'object-fit-contain'}"/>
                                </div>
                            </aside>
                            <main class="ps-2">
                                <div class="mb-1">
                                    <field name="name" class="mb-0 fw-bold fs-5"/>
                                </div>
                                <div t-if="record.profile_id.raw_value">
                                    <i class="fa fa-fw me-1 fa-user text-primary" title="Owner"/>
                                    <field name="profile_id"/>
                                </div>
                                <div t-if="record._type.raw_value" class="text-truncate">
                                    <i class="fa fa-fw me-1 fa-tag text-primary" title="Type"/>
                                    <field name="_type"/>
                                </div>
                                <div t-if="record.show_certificates.raw_value"
                                     class="mt-2 d-flex flex-row gap-1 justify-content-end align-items-center">
                                    <!-- PIRT Icon -->
                                    <span t-if="record.pirt_icon_color.raw_value == 'grey'"
                                          t-att-title="record.pirt_tooltip.raw_value"
                                          style="display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; border-radius: 4px; font-weight: bold; font-size: 14px; color: white; background-color: #6c757d;">
                                        P
                                    </span>
                                    <span t-if="record.pirt_icon_color.raw_value == 'yellow'"
                                          t-att-title="record.pirt_tooltip.raw_value"
                                          style="display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; border-radius: 4px; font-weight: bold; font-size: 14px; color: #212529; background-color: #ffc107;">
                                        P
                                    </span>
                                    <span t-if="record.pirt_icon_color.raw_value == 'green'"
                                          t-att-title="record.pirt_tooltip.raw_value"
                                          style="display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; border-radius: 4px; font-weight: bold; font-size: 14px; color: white; background-color: #28a745;">
                                        P
                                    </span>
                                    <!-- Halal Icon -->
                                    <span t-if="record.halal_icon_color.raw_value == 'grey'"
                                          t-att-title="record.halal_tooltip.raw_value"
                                          style="display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; border-radius: 4px; font-weight: bold; font-size: 14px; color: white; background-color: #6c757d;">
                                        H
                                    </span>
                                    <span t-if="record.halal_icon_color.raw_value == 'yellow'"
                                          t-att-title="record.halal_tooltip.raw_value"
                                          style="display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; border-radius: 4px; font-weight: bold; font-size: 14px; color: #212529; background-color: #ffc107;">
                                        H
                                    </span>
                                    <span t-if="record.halal_icon_color.raw_value == 'green'"
                                          t-att-title="record.halal_tooltip.raw_value"
                                          style="display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; border-radius: 4px; font-weight: bold; font-size: 14px; color: white; background-color: #28a745;">
                                        H
                                    </span>
                                    <!-- BPOM Icon -->
                                    <span t-if="record.bpom_icon_color.raw_value == 'grey'"
                                          t-att-title="record.bpom_tooltip.raw_value"
                                          style="display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; border-radius: 4px; font-weight: bold; font-size: 14px; color: white; background-color: #6c757d;">
                                        B
                                    </span>
                                    <span t-if="record.bpom_icon_color.raw_value == 'yellow'"
                                          t-att-title="record.bpom_tooltip.raw_value"
                                          style="display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; border-radius: 4px; font-weight: bold; font-size: 14px; color: #212529; background-color: #ffc107;">
                                        B
                                    </span>
                                    <span t-if="record.bpom_icon_color.raw_value == 'green'"
                                          t-att-title="record.bpom_tooltip.raw_value"
                                          style="display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; border-radius: 4px; font-weight: bold; font-size: 14px; color: white; background-color: #28a745;">
                                        B
                                    </span>
                                </div>
                            </main>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Products View for UMKM Profile -->
        <record id="view_umkm_products_forumkmprofile_list" model="ir.ui.view">
            <field name="name">umkm.products.forumkmprofile.list</field>
            <field name="model">umkm.products</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name" placeholder="Masukkan nama produk"/>
                    <field name="_type" placeholder="Pilih jenis produk"/>
                    <field name="price" placeholder="Masukkan harga"/>
                    <field name="currency_id" invisible="1"/>
                </list>
            </field>
        </record>

        <!-- Products Action -->
        <record id="action_umkm_products" model="ir.actions.act_window">
            <field name="name">Produk UMKM</field>
            <field name="res_model">umkm.products</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="view_id" ref="view_umkm_products_kanban"/>
            <field name="search_view_id" ref="view_umkm_products_search"/>
        </record>
    </data>
</odoo>